{
  "name": "decky-codex",
  "version": "0.1.0",
  "description": "Codex assistant for Steam Deck Gaming Mode",
  "type": "module",
  "license": "MIT",
  "repository": "github:Kevni92/decky-codex",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v",
    "package": "python3 scripts/package.py",
    "test:ui": "rollup tests/ui-host.js --file out/ui-host.js --format iife -p @rollup/plugin-node-resolve -p @rollup/plugin-commonjs && node tests/ui.mjs"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "@decky/ui": "4.11.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@sparticuz/chromium": "131.0.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "playwright": "1.62.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.9.3"
  }
}
